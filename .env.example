# 本地开发、测试、演示和生产都使用 PostgreSQL + TimescaleDB。
FINANCE_AGENT_DATABASE_URL=postgresql+psycopg://finance_agent:finance_agent@localhost:5432/finance_agent

# Redis 只用于热数据缓存、Agent 输入上下文缓存、任务锁和 Provider 熔断状态。
# 不把历史 K 线、财务快照、原始响应、推荐结果等事实数据只存在 Redis。
FINANCE_AGENT_REDIS_URL=redis://localhost:6379/0

# Compose 容器间使用服务名通信；只有接入外部数据库或 Redis 时才需要覆盖。
FINANCE_AGENT_DOCKER_DATABASE_URL=postgresql+psycopg://finance_agent:finance_agent@postgres:5432/finance_agent
FINANCE_AGENT_DOCKER_REDIS_URL=redis://redis:6379/0
FINANCE_AGENT_DOCKER_GRAPH_CONFIG_FILE=config/graph.neo4j.example.toml

# Docker 前后端默认仅绑定本机。FINANCE_AGENT_WEB_API_BASE 是构建时 API 地址，默认使用 Nginx 同源代理。
FINANCE_AGENT_API_BIND_HOST=127.0.0.1
FINANCE_AGENT_API_PORT=8000
FINANCE_AGENT_WEB_BIND_HOST=127.0.0.1
FINANCE_AGENT_WEB_PORT=5173
FINANCE_AGENT_WEB_API_BASE=/

# Python 后端镜像构建使用的公开镜像源，可按部署网络覆盖为官方 PyPI 或内部制品库。
FINANCE_AGENT_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# SQLAlchemy 单进程连接池上限：pool_size + max_overflow = 30。
FINANCE_AGENT_DB_POOL_SIZE=10
FINANCE_AGENT_DB_MAX_OVERFLOW=20
FINANCE_AGENT_DB_POOL_TIMEOUT_SECONDS=30
FINANCE_AGENT_DB_POOL_RECYCLE_SECONDS=1800

# GraphStore 知识图谱后端通过配置文件显式二选一。
# 默认推荐 Neo4j / DozerDB；Apache AGE 是另一种可选部署形态，不是 fallback。
FINANCE_AGENT_GRAPH_CONFIG_FILE=config/graph.neo4j.example.toml

# Hermes 仅在程序触发器超过阈值时被 Webhook 唤醒。密钥必须与 ~/.hermes/config.yaml
# 中 finance-agent 路由的 secret 一致，不要提交真实密钥。
FINANCE_AGENT_HERMES_WEBHOOK_URL=http://host.docker.internal:8644/webhooks/finance-agent
FINANCE_AGENT_HERMES_WEBHOOK_SECRET=
FINANCE_AGENT_HERMES_WEBHOOK_TIMEOUT_SECONDS=10
