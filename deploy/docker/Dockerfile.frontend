FROM node:22-alpine AS build

WORKDIR /app

COPY apps/agent-office/package.json apps/agent-office/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY apps/agent-office ./

ARG VITE_FINANCE_AGENT_API_BASE=/
ENV VITE_FINANCE_AGENT_API_BASE=${VITE_FINANCE_AGENT_API_BASE}

RUN npm run build

FROM nginx:alpine

COPY deploy/docker/nginx.agent-office.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --spider --quiet http://127.0.0.1/healthz || exit 1
