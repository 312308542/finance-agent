FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FINANCE_AGENT_PROJECT_ROOT=/app \
    FINANCE_AGENT_RUNTIME_DIR=/app/runtime

WORKDIR /app

# TA-Lib Python 包依赖 TA-Lib C 库；slim 镜像中通常没有预装。
ARG TA_LIB_VERSION=0.4.0
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        make \
        wget \
    && wget -O /tmp/ta-lib.tar.gz "https://prdownloads.sourceforge.net/ta-lib/ta-lib-${TA_LIB_VERSION}-src.tar.gz" \
    && mkdir -p /tmp/ta-lib-src \
    && tar -xzf /tmp/ta-lib.tar.gz -C /tmp/ta-lib-src --strip-components=1 \
    && cd /tmp/ta-lib-src \
    && ./configure --prefix=/usr \
    && make \
    && make install \
    && ldconfig \
    && rm -rf /tmp/ta-lib.tar.gz /tmp/ta-lib-src \
    && apt-get purge -y --auto-remove wget make \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY scripts ./scripts

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

RUN mkdir -p /app/runtime/base_data_scheduler

CMD ["sh", "-c", "exec python scripts/data/run_base_data_scheduler.py --loop --config \"$FINANCE_AGENT_RUNTIME_DIR/base_data_scheduler/base_data_scheduler.json\" --status-file \"$FINANCE_AGENT_RUNTIME_DIR/base_data_scheduler/status.json\" --event-log-file \"$FINANCE_AGENT_RUNTIME_DIR/base_data_scheduler/events.jsonl\""]
